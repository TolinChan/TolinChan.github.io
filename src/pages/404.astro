---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="你访问的页面不存在。">
  <section class="not-found shell">
    <div>
      <strong aria-hidden="true">404</strong>
      <h1>这页暂时不在这里。</h1>
      <p><a href="/">回到首页</a>，或前往 <a href="/文章/">文章归档</a>。</p>
    </div>
  </section>
</BaseLayout>
