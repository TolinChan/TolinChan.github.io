---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPostCategories, sortPosts, termSlug } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
  const terms = new Map<string, { name: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const name of getPostCategories(post)) {
      const slug = termSlug(name);
      const current = terms.get(slug) || { name, posts: [] };
      current.posts.push(post);
      terms.set(slug, current);
    }
  }
  return [...terms.entries()].map(([term, value]) => ({
    params: { term },
    props: value,
  }));
}) satisfies GetStaticPaths;

const { name, posts } = Astro.props;
---

<BaseLayout title={`分类：${name}`} description={`“${name}”分类下的文章。`} canonicalPath={Astro.url.pathname}>
  <section class="section">
    <div class="shell">
      <div class="section-heading"><div><span class="eyebrow">Category</span><h1>{name}</h1></div></div>
      <div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
    </div>
  </section>
</BaseLayout>
