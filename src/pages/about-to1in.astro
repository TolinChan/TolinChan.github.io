---
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutHtml from '../data/about.html?raw';
---

<BaseLayout title="About To1in" description="关于 To1in。" canonicalPath="/about-to1in/">
  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">About</span>
          <h1>About To1in</h1>
        </div>
      </div>
      <article class="about-card post-content" set:html={aboutHtml} />
    </div>
  </section>
</BaseLayout>
