---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { sortPosts, termHref } from '../utils/posts';

const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
const latest = posts.slice(0, 8);
const categoryCounts = new Map<string, number>();
for (const post of posts) {
  for (const category of post.data.categories) {
    categoryCounts.set(category, (categoryCounts.get(category) || 0) + 1);
  }
}
const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <span class="eyebrow">Security · Crypto · Notes</span>
        <h1>拆解问题，留下思考。</h1>
        <p class="hero-copy">
          这里记录密码学、安全研究、CTF 与偶尔偏离技术轨道的生活片段。
        </p>
      </div>
      <aside class="hero-note" aria-label="博客归档统计">
        <strong>{posts.length}</strong>
        <span>篇从旧站完整迁移的文章</span>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Latest writing</span>
          <h2>最近文章</h2>
        </div>
        <a href="/文章/">查看全部文章 →</a>
      </div>
      <div class="post-list">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  {categories.length > 0 && (
    <section class="section">
      <div class="shell">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Topics</span>
            <h2>文章分类</h2>
          </div>
        </div>
        <div class="term-cloud">
          {categories.map(([category, count]) => (
            <a href={termHref('category', category)}>{category} · {count}</a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
