---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPostCategories, sortPosts, termHref } from '../utils/posts';

const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
const latest = posts.slice(0, 6);
const categoryCounts = new Map<string, number>();
for (const post of posts) {
  for (const category of getPostCategories(post)) {
    categoryCounts.set(category, (categoryCounts.get(category) || 0) + 1);
  }
}
const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-content">
        <span class="eyebrow" data-hero-step="eyebrow">To1in 的个人博客</span>
        <h1 class="heading-1" data-hero-step="title">你好，我是<br /><span>To1in.</span></h1>
        <p class="hero-lead" data-hero-step="lead">
          上海科技大学计算机硕士生，陈浩贤老师课题组成员。关注形式化方法、程序验证，以及区块链漏洞的检测与修复。
        </p>
        <ul class="hero-topics" aria-label="关注方向" data-hero-step="topics">
          <li>Formal Methods</li>
          <li>Blockchain Security</li>
          <li>Cryptography</li>
        </ul>
        <div class="hero-actions" data-hero-step="actions">
          <a class="button button--primary" href="/文章/">读一读我的文章 <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/about-to1in/">关于我 <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-note" data-hero-step="note">也记录旅行、音乐，以及研究之外仍值得记住的日常。</p>
      </div>
      <aside class="hero-notebook" aria-label="博客简介" data-motion-reveal>
        <div class="notebook-topline">
          <span>Personal notebook</span>
          <span aria-hidden="true">↗</span>
        </div>
        <span class="notebook-mark" aria-hidden="true">t.</span>
        <p>一份持续生长的<br />个人笔记。</p>
        <div class="notebook-bottomline">
          <span>{posts.length} 篇记录 · 始于 2021</span>
          <a href="/时光轴/" aria-label="浏览博客时光轴">翻开看看 <span aria-hidden="true">→</span></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="focus-section" aria-label="博客主题">
    <div class="shell focus-grid">
      <a href="/category/ctf/" data-motion-group="focus">
        <strong>密码与安全</strong>
        <small>CTF / Crypto <span aria-hidden="true">↗</span></small>
      </a>
      <a href="/category/论文阅读/" data-motion-group="focus">
        <strong>研究与学习</strong>
        <small>Papers / Formal Methods <span aria-hidden="true">↗</span></small>
      </a>
      <a href="/时光轴/" data-motion-group="focus">
        <strong>生活与见闻</strong>
        <small>Travel / Music / Life <span aria-hidden="true">↗</span></small>
      </a>
    </div>
  </section>

  <section class="section section--latest">
    <div class="shell">
      <div class="section-heading" data-motion-reveal>
        <div>
          <span class="eyebrow">Writing</span>
          <h2 class="heading-3">最近的记录</h2>
        </div>
        <a class="section-link" href="/文章/">全部 {posts.length} 篇文章 →</a>
      </div>
      <div class="post-list">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  {categories.length > 0 && (
    <section class="section">
      <div class="shell">
        <div class="section-heading" data-motion-reveal>
          <div>
            <span class="eyebrow">Topics</span>
            <h2>沿着主题阅读</h2>
          </div>
        </div>
        <div class="term-cloud">
          {categories.map(([category, count]) => (
            <a href={termHref('category', category)}>{category} · {count}</a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
