---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
}

const {
  title = "To1in's Blog",
  description = '密码学、安全与技术随笔。',
  canonicalPath = Astro.url.pathname,
  type = 'website',
} = Astro.props;
const pageTitle = title === "To1in's Blog" ? title : `${title} · To1in's Blog`;
const canonical = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfaf8" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="To1in's Blog RSS" href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="To1in's Blog" />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
    <slot name="head" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const preferred = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = saved || preferred;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
