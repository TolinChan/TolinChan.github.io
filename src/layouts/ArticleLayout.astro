---
import type { BlogPost } from '../utils/posts';
import { formatDate, termHref } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';
import LegacyComments from '../components/LegacyComments.astro';
import Giscus from '../components/Giscus.astro';
import PostEnhancements from '../components/PostEnhancements.astro';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={post.data.route}
  type="article"
>
  <div class="shell article-shell">
    <article class="article">
      <header class="article-header">
        <a class="eyebrow" href="/文章/">文章</a>
        <h1>{post.data.title}</h1>
        <div class="article-meta">
          <time datetime={post.data.publishedAt.toISOString()}>
            发布于 {formatDate(post.data.publishedAt)}
          </time>
          {post.data.updatedAt && (
            <time datetime={post.data.updatedAt.toISOString()}>
              更新于 {formatDate(post.data.updatedAt)}
            </time>
          )}
        </div>
        {(post.data.categories.length > 0 || post.data.tags.length > 0) && (
          <div class="article-terms">
            {post.data.categories.map((category) => (
              <a href={termHref('category', category)}>{category}</a>
            ))}
            {post.data.tags.map((tag) => (
              <a href={termHref('tag', tag)}>#{tag}</a>
            ))}
          </div>
        )}
      </header>
      <div class="post-content">
        <slot />
      </div>
    </article>
    <LegacyComments legacyId={post.data.legacyId} />
    <Giscus />
  </div>
  <PostEnhancements />
</BaseLayout>
