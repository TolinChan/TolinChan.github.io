---
import type { BlogPost } from '../utils/posts';
import {
  formatDate,
  getPostCategories,
  getPostDescription,
  termHref,
} from '../utils/posts';
import BaseLayout from './BaseLayout.astro';
import LegacyComments from '../components/LegacyComments.astro';
import Giscus from '../components/Giscus.astro';
import PostEnhancements from '../components/PostEnhancements.astro';
import legacyViews from '../data/legacy-views.json';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const categories = getPostCategories(post);
const legacyViewCount = (legacyViews as Record<string, number>)[post.data.legacyId] ?? 0;
---

<BaseLayout
  title={post.data.title}
  description={getPostDescription(post, 150)}
  canonicalPath={post.data.route}
  type="article"
>
  <div class="shell article-shell">
    <article class="article">
      <header class="article-header" data-motion-reveal>
        <a class="eyebrow" href="/文章/">文章</a>
        <h1>{post.data.title}</h1>
        <div class="article-meta">
          <time datetime={post.data.publishedAt.toISOString()}>
            发布于 {formatDate(post.data.publishedAt)}
          </time>
          {post.data.updatedAt && (
            <time datetime={post.data.updatedAt.toISOString()}>
              更新于 {formatDate(post.data.updatedAt)}
            </time>
          )}
          <span id="busuanzi_container_page_pv" style="display: none">
            阅读 <span id="article-view-count" data-legacy-views={legacyViewCount}>{legacyViewCount}</span> 次
            <span id="busuanzi_value_page_pv" hidden></span>
          </span>
        </div>
        {(categories.length > 0 || post.data.tags.length > 0) && (
          <div class="article-terms">
            {categories.map((category) => (
              <a href={termHref('category', category)}>{category}</a>
            ))}
            {post.data.tags.map((tag) => (
              <a href={termHref('tag', tag)}>#{tag}</a>
            ))}
          </div>
        )}
      </header>
      <div class="post-content">
        <slot />
      </div>
    </article>
    <LegacyComments legacyId={post.data.legacyId} />
    <Giscus />
  </div>
  <PostEnhancements />
  <script>
    const currentViews = document.getElementById('busuanzi_value_page_pv');
    const totalViews = document.getElementById('article-view-count');
    if (currentViews && totalViews) {
      const baseline = Number(totalViews.dataset.legacyViews);
      const updateTotal = () => {
        const current = currentViews.textContent?.trim() ?? '';
        if (!/^\d+$/.test(current)) return;
        const total = baseline + Number(current);
        if (Number.isSafeInteger(total)) totalViews.textContent = String(total);
      };
      new MutationObserver(updateTotal).observe(currentViews, {
        childList: true,
        characterData: true,
        subtree: true,
      });
      updateTotal();
    }
  </script>
  <script
    is:inline
    async
    src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"
  ></script>
</BaseLayout>
