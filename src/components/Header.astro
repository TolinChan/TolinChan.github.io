---
const navigation = [
  { href: '/', label: '首页' },
  { href: '/文章/', label: '文章' },
  { href: '/时光轴/', label: '时光轴' },
  { href: '/友情链接/', label: '友情链接' },
  { href: '/旅游相册/', label: '旅游相册' },
  { href: '/about-to1in/', label: '关于' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === href : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="To1in's Blog 首页">
      <img
        class="brand-avatar"
        src="/wp-content/uploads/2021/07/QQ图片20210727121230.jpg"
        alt=""
        width="40"
        height="40"
      />
      <span class="brand-copy">
        <span class="brand-name">To1in</span>
        <span class="brand-note">Research journal</span>
      </span>
    </a>
    <nav class="main-nav" aria-label="主导航">
      {navigation.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <button
      class="theme-toggle"
      id="theme-toggle"
      type="button"
      aria-label="切换明暗主题"
      title="切换明暗主题"
    >
      <span aria-hidden="true">◐</span>
    </button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
  button?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme;
    const theme = current === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    localStorage.setItem('theme', theme);
    document.dispatchEvent(new CustomEvent('themechange', { detail: { theme } }));
  });
</script>
