<script>
  import renderMathInElement from 'katex/contrib/auto-render';

  function slugifyHeading(value: string) {
    return value
      .normalize('NFKC')
      .trim()
      .toLocaleLowerCase('zh-CN')
      .replace(/\s+/g, '-')
      .replace(/[^\p{Letter}\p{Number}\-_]+/gu, '') || 'section';
  }

  function buildToc(article: Element) {
    const placeholders = article.querySelectorAll<HTMLElement>('[data-auto-toc]');
    if (!placeholders.length) return;
    const headings = [...article.querySelectorAll<HTMLElement>('h2, h3')]
      .filter((heading) => !heading.closest('[data-auto-toc]'));
    if (!headings.length) {
      placeholders.forEach((placeholder) => placeholder.remove());
      return;
    }
    const used = new Map<string, number>();
    headings.forEach((heading) => {
      let id = heading.id || slugifyHeading(heading.textContent || '');
      const count = used.get(id) || 0;
      used.set(id, count + 1);
      if (count) id = `${id}-${count + 1}`;
      heading.id = id;
    });
    placeholders.forEach((placeholder) => {
      const title = document.createElement('strong');
      title.textContent = '文章目录';
      const list = document.createElement('ol');
      headings.forEach((heading) => {
        const item = document.createElement('li');
        item.dataset.level = heading.tagName === 'H3' ? '3' : '2';
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent || heading.id;
        item.append(link);
        list.append(item);
      });
      placeholder.replaceChildren(title, list);
    });
  }

  function enableReadingProgress(article: HTMLElement) {
    const articleElement = article.closest<HTMLElement>('.article');
    if (!articleElement) return;

    document.body.dataset.readingProgress = 'true';
    let frame: number | undefined;

    const updateProgress = () => {
      frame = undefined;
      const articleTop = articleElement.getBoundingClientRect().top + window.scrollY;
      const articleBottom = articleTop + articleElement.offsetHeight;
      const readingPoint = window.scrollY + window.innerHeight * 0.45;
      const progress = Math.min(
        1,
        Math.max(0, (readingPoint - articleTop) / Math.max(articleBottom - articleTop, 1)),
      );
      document.documentElement.style.setProperty('--reading-progress', String(progress));
    };

    const requestProgressUpdate = () => {
      if (frame === undefined) frame = window.requestAnimationFrame(updateProgress);
    };

    window.addEventListener('scroll', requestProgressUpdate, { passive: true });
    window.addEventListener('resize', requestProgressUpdate, { passive: true });
    requestProgressUpdate();
  }

  function enhancePost() {
    const article = document.querySelector<HTMLElement>('.post-content');
    if (!article) return;
    const pageTitle = document.querySelector<HTMLElement>('.article-header h1');
    const firstLegacyTitle = article.querySelector<HTMLElement>('h1');
    if (
      pageTitle &&
      firstLegacyTitle &&
      pageTitle.textContent?.trim() === firstLegacyTitle.textContent?.trim()
    ) {
      firstLegacyTitle.remove();
    }
    buildToc(article);
    renderMathInElement(article, {
      throwOnError: false,
      strict: false,
      ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '\\[', right: '\\]', display: true },
        { left: '\\(', right: '\\)', display: false },
        { left: '$', right: '$', display: false },
      ],
    });
    enableReadingProgress(article);
  }

  enhancePost();
</script>
