---
import type { BlogPost } from '../utils/posts';
import {
  formatDate,
  getPostCategories,
  getPostDescription,
  termHref,
} from '../utils/posts';

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const description = getPostDescription(post);
const categories = getPostCategories(post);
---

<article class:list={['post-card', { 'post-card--featured': featured }]}>
  <div class="post-card-meta">
    <time datetime={post.data.publishedAt.toISOString()}>
      {formatDate(post.data.publishedAt)}
    </time>
    {categories[0] && (
      <a href={termHref('category', categories[0])}>
        {categories[0]}
      </a>
    )}
  </div>
  <div class="post-card-body">
    <h2><a href={post.data.route}>{post.data.title}</a></h2>
    <p>{description}</p>
    {post.data.tags.length > 0 && (
      <ul class="inline-tags" aria-label="标签">
        {post.data.tags.slice(0, 3).map((tag) => (
          <li><a href={termHref('tag', tag)}>#{tag}</a></li>
        ))}
      </ul>
    )}
  </div>
  <a class="post-card-link" href={post.data.route} aria-label={`阅读《${post.data.title}》`}>
    <span aria-hidden="true">↗</span>
  </a>
</article>
